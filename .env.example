# PostgreSQL connection string used by Prisma and the pg driver adapter.
# Create the database first, e.g.  createdb bsuc
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bsuc?schema=public"

# Secret used to sign session tokens — must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# How long a session stays valid.
JWT_EXPIRES_IN="7d"

# HTTP port the API listens on.
PORT=5000

# Allowed origin for CORS (the frontend). Verification links point here.
CLIENT_ORIGIN=http://localhost:3000

# Outgoing mail. Leave SMTP_HOST unset in development: a throwaway Ethereal
# inbox is created automatically and a preview link is logged for each message.
# Required in production.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
MAIL_FROM="BSUC <no-reply@bsuc-chemnitz.de>"

# Cloudinary, for profile photos. Find these on your Cloudinary dashboard.
# Without them the upload endpoints return a clear error and the UI falls back
# to initials — nothing else breaks.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
