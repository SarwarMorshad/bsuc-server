// Prisma schema for bsuc-server
// Docs: https://pris.ly/d/prisma-schema
// Connection URL is configured in prisma.config.ts (reads DATABASE_URL from .env).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum DegreeLevel {
  BACHELOR
  MASTER
  PHD
  OTHER
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

/// A community member (also used for admins via `role`).
model User {
  id     String @id @default(cuid())
  name   String
  email  String @unique
  passwordHash String

  /// University-issued matriculation number. Unique — one account per student.
  matriculationNumber String @unique

  program       String?
  countryRegion String?
  year          Int?

  /// Optional contact number (also used for WhatsApp). Private by default.
  phone       String?
  degreeLevel DegreeLevel?
  /// Year the member arrived in Chemnitz — identifies who is new.
  arrivalYear Int?
  bio         String?
  /// Address awaiting confirmation during an email change.
  pendingEmail String?
  role          Role     @default(MEMBER)
  /// Profile photo, delivered from Cloudinary.
  avatarUrl String?
  /// Cloudinary public ID, kept so the old image can be removed on replace.
  avatarPublicId String?
  /// Set once the member confirms ownership of their email address.
  emailVerified DateTime?
  createdAt     DateTime @default(now())

  rsvps              Rsvp[]
  verificationTokens VerificationToken[]

  @@map("users")
}

/// One-time email verification token. Only a hash is stored, so a database
/// leak cannot be used to verify someone else's account.
model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  /// Set when the token confirms an email *change*: redeeming it moves this
  /// address onto the account. Null for ordinary sign-up verification.
  newEmail String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

/// A community event (Boishakh, Eid, welcome dinners, etc.).
model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  location    String?
  description String?
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  rsvps Rsvp[]

  @@map("events")
}

/// A member's RSVP to an event.
model Rsvp {
  id       String     @id @default(cuid())
  status   RsvpStatus @default(GOING)
  memberId String
  eventId  String

  member User  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId])
  @@map("rsvps")
}

enum JobType {
  HIWI
  WERKSTUDENT
  INTERNSHIP
  PART_TIME
}

/// A job or internship listing shown in the members-only job portal.
model Job {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String?
  type        JobType  @default(PART_TIME)
  description String
  applyUrl    String?
  deadline    DateTime?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
  @@map("jobs")
}

/// Editable site text blocks (key/value), managed from the admin panel.
model Content {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("content")
}
