// Prisma schema for bsuc-server
// Docs: https://pris.ly/d/prisma-schema
// Connection URL is configured in prisma.config.ts (reads DATABASE_URL from .env).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum DegreeLevel {
  BACHELOR
  MASTER
  PHD
  OTHER
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

/// A community member (also used for admins via `role`).
model User {
  id     String @id @default(cuid())
  name   String
  email  String @unique
  passwordHash String

  /// University-issued matriculation number. Unique — one account per student.
  matriculationNumber String @unique

  program       String?
  countryRegion String?
  year          Int?

  /// Optional contact number (also used for WhatsApp). Private by default.
  phone       String?
  degreeLevel DegreeLevel?
  /// Year the member arrived in Chemnitz — identifies who is new.
  arrivalYear Int?
  bio         String?
  /// Address awaiting confirmation during an email change.
  pendingEmail String?
  role          Role     @default(MEMBER)

  /// Bumped to invalidate every token already issued for this user — on
  /// logout, and whenever the password changes. Tokens carry the version they
  /// were signed with, so an old one stops being accepted immediately instead
  /// of lingering until it expires.
  tokenVersion  Int      @default(0)
  /// Profile photo, delivered from Cloudinary.
  avatarUrl String?
  /// Cloudinary public ID, kept so the old image can be removed on replace.
  avatarPublicId String?
  /// Set once the member confirms ownership of their email address.
  emailVerified DateTime?
  createdAt     DateTime @default(now())

  rsvps              Rsvp[]
  verificationTokens VerificationToken[]

  @@map("users")
}

/// One-time email verification token. Only a hash is stored, so a database
/// leak cannot be used to verify someone else's account.
model VerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  /// Set when the token confirms an email *change*: redeeming it moves this
  /// address onto the account. Null for ordinary sign-up verification.
  newEmail String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

/// A community event (Boishakh, Eid, welcome dinners, etc.).
model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  location    String?
  description String?
  imageUrl    String?
  /// Cloudinary public ID, kept so the old image can be removed on replace.
  imagePublicId String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  rsvps Rsvp[]

  @@map("events")
}

/// A member's RSVP to an event.
model Rsvp {
  id       String     @id @default(cuid())
  status   RsvpStatus @default(GOING)
  memberId String
  eventId  String

  member User  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([memberId, eventId])
  @@map("rsvps")
}

/// The kinds of position a German university job board carries. Values are
/// only ever added — an existing listing must keep meaning what it meant.
enum JobType {
  // While studying
  HIWI // Studentische / Wissenschaftliche Hilfskraft
  WERKSTUDENT
  INTERNSHIP // Praktikum
  MINIJOB // geringfügige Beschäftigung
  PART_TIME // Nebenjob / Teilzeit
  THESIS // Abschlussarbeit im Unternehmen
  DUAL_STUDY // Duales Studium

  // After graduating
  ENTRY_LEVEL // Berufseinstieg
  TRAINEE
  FULL_TIME
  PHD // Promotion

  // Other arrangements
  FREELANCE // Freiberuflich / Werkvertrag
}

/// Nothing reaches members until an admin approves it.
enum JobStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayUnit {
  HOUR
  MONTH
}

/// How much German the role needs. ENGLISH_OK means German is not required.
enum GermanLevel {
  ENGLISH_OK
  A1
  A2
  B1
  B2
  C1
  C2
}

/// A job listing for the members-only portal.
///
/// Adverts are written in German, following the usual Stellenanzeige
/// structure (Über uns / Aufgaben / Profil / Wir bieten), so the body fields
/// are single-language on purpose.
model Job {
  id String @id @default(cuid())

  // --- Position ---
  /// Must carry the (m/w/d) marker; the AGG forbids gendered adverts.
  title          String
  company        String
  companyWebsite String?
  location       String?
  remote         Boolean @default(false)
  type           JobType @default(PART_TIME)
  /// null means "ab sofort".
  startDate      DateTime?
  /// null means unbefristet.
  until          DateTime?
  hoursPerWeek   Int?

  /// Pay in cents to keep the arithmetic exact — 13.90 EUR/h is 1390.
  payCents Int?
  payUnit  PayUnit @default(HOUR)
  /// For the cases a number cannot express, e.g. an unpaid mandatory internship.
  payNote  String?

  // --- The advert itself, in German ---
  aboutCompany String
  tasks        String
  profile      String
  offer        String?
  germanLevel  GermanLevel?

  // --- How to apply ---
  contactName String?
  applyEmail  String?
  applyUrl    String?
  deadline    DateTime?

  // --- Who submitted it. Never shown publicly: this is how the committee
  //     replies, and how it judges whether the employer is real. ---
  submitterName  String
  submitterEmail String
  submitterPhone String?

  // --- Moderation ---
  status          JobStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("jobs")
}

/// Editable site text blocks (key/value), managed from the admin panel.
model Content {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("content")
}
